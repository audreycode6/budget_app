# Copy this file, then fill in real values:
#   cp .env.sample .env.docker    # for Docker Compose (local and server)
#   cp .env.sample .env           # to run without Docker (poetry run app start)

# Read by the db service and its healthcheck
POSTGRES_USER=budget_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=budget_db

# Host is the db service name under Compose. Use localhost:5432 without Docker.
DATABASE_URL=postgresql://budget_user:change_me@db:5432/budget_db

SECRET_KEY=secret_key

# true on the server (HTTPS). Keep false locally, or you can't log in over HTTP.
SESSION_COOKIE_SECURE=false

# Only used by the Flask dev server. Ignored under Docker, where the Dockerfile
# binds gunicorn to 0.0.0.0:3000.
APP_PORT=3000
